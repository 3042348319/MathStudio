#version 450

// ====================================================================
// 无限网格地板 —— 顶点着色器
// 不读取顶点缓冲, 用 gl_VertexIndex 生成一个覆盖全屏的大三角形。
// 真正的网格图案由 grid.frag 根据世界坐标计算。
// ====================================================================

void main() {
    const vec2 positions[3] = vec2[](
        vec2(-1.0, -1.0),
        vec2( 3.0, -1.0),
        vec2(-1.0,  3.0)
    );
    gl_Position = vec4(positions[gl_VertexIndex], 0.0, 1.0);
}
